<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.*" />

    <!-- OpenTelemetry.Api pinned to avoid GHSA-8785-wc3w-h8q6 / GHSA-g94r-2vxg-569j (1.10.0). -->
    <PackageVersion Include="OpenTelemetry" Version="1.15.*" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.*" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.*" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.*" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.*" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.*" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="1.15.*-*" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.*-*" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.15.*" />

    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
    <PackageVersion Include="Shouldly" Version="4.*" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.*" />

    <!-- EF Core + Postgres (PORTAL-002, ADR-0028/0029) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="10.*" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.*" />

    <!-- Time -->
    <PackageVersion Include="NodaTime" Version="3.*" />

    <!-- Test isolation -->
    <PackageVersion Include="Respawn" Version="6.*" />
    <PackageVersion Include="NodaTime.Testing" Version="3.*" />

    <!-- Transitive pins to satisfy CVE warnings-as-errors (Respawn 6 pulls SqlClient which transitively pulls these). -->
    <PackageVersion Include="Azure.Identity" Version="1.13.*" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.*" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.*" />
    <PackageVersion Include="System.Drawing.Common" Version="8.*" />
  </ItemGroup>
</Project>
