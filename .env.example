# Copy this file to `.env` on the production VM and fill in real values.
# Local dev does NOT need a `.env` file — docker-compose.override.yml provides
# defaults pointing at the local Postgres service.

# Portal Postgres connection string (Azure Database for PostgreSQL Flexible Server).
# SslMode=Require is required by Flexible Server.
# Example:
#   PORTAL_DB_CONNECTION_STRING=Host=myportal.postgres.database.azure.com;Port=5432;Database=portal_prod;Username=admin;Password=...;SslMode=Require;Trust Server Certificate=true;Pooling=true;Maximum Pool Size=20
PORTAL_DB_CONNECTION_STRING=

# Google OAuth credentials (portal sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL of the portal (used by cloud-init callbacks).
PROVISIONING_PORTAL_URL=

# Cloudflare API for managing DNS records on user-cloud subdomains.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Cloud-init defaults baked into user-cloud provisioning.
CLOUDINIT_LE_EMAIL=letsencrypt@thany.click
CLOUDINIT_LE_ACME_CA=
CLOUDINIT_IMAGE_TAG=main
CLOUDINIT_SSH_PUBLIC_KEY=
