{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Portal": "Host=localhost;Port=5432;Username=postgres;Password=postgres;Database=portal_dev"
  },
  "Google": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "Auth": {
    "Passkey": {
      "ServerDomain": "thany.click",
      "ServerName": "Thany-Marcus Portal",
      "Origins": [ "https://thany.click" ],
      "ChallengeTtlSeconds": 300
    }
  },
  "DigitalOcean": {
    "OAuth": {
      "ClientId": "",
      "ClientSecret": "",
      "CallbackUrl": ""
    }
  },
  "RateLimiting": {
    "TotpChallenge": { "PermitLimit": 5, "WindowSeconds": 300 },
    "Unlock":        { "PermitLimit": 5, "WindowSeconds": 300 },
    "SignInGoogle":  { "PermitLimit": 20, "WindowSeconds": 60 },
    "SignupPasskey": { "PermitLimit": 10, "WindowSeconds": 3600 }
  },
  "Lockout": {
    "Totp":   { "MaxFailures": 20, "WindowSeconds": 3600, "LockoutSeconds": 1800 },
    "Unlock": { "MaxFailures": 20, "WindowSeconds": 3600, "LockoutSeconds": 1800 },
    "Sweep":  { "IntervalSeconds": 21600, "RetentionDays": 30 }
  },
  "Turnstile": {
    "SiteKey":           "",
    "SecretKey":         "",
    "SiteVerifyUrl":     "https://challenges.cloudflare.com/turnstile/v0/siteverify",
    "FailureThreshold":  5,
    "TrackerTtlSeconds": 900,
    "TimeoutSeconds":    5
  }
}
