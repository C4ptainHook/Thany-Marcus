{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "DefaultAnthropicModel": "claude-haiku-4-5-20251001",
    "DefaultOpenAiModel": "gpt-4o-mini",
    "BodySectionHeader": "## Body",
    "AttachmentsSectionHeader": "## Attachments",
    "AttachmentHeaderTemplate": "### Attachment {0} (kind={1})",
    "SystemPrompt": "You enrich short Markdown notes captured by a user. Given the note body and any extracted attachment text, (1) suggest a project folder name if obvious, otherwise null; (2) identify named entities in the body and propose wikilink anchors (text + char offsets + target slug); (3) propose 2-6 short kebab-case tags. Be conservative: prefer few high-quality anchors. Never invent entities not in the input."
  },
  "IngestSaga": {
    "Orchestrator": {
      "MaxConcurrentJobs": 3,
      "LeaseSeconds": 60,
      "HeartbeatSeconds": 20,
      "IdlePollMs": 60000
    },
    "Phases": {
      "extracting_attachments": { "MaxAttempts": 1, "BackoffSecondsBase": 2 },
      "composing":              { "MaxAttempts": 2, "BackoffSecondsBase": 2 },
      "routing":                { "MaxAttempts": 3, "BackoffSecondsBase": 2 },
      "extracting_entities":    { "MaxAttempts": 3, "BackoffSecondsBase": 2 },
      "embedding":              { "MaxAttempts": 3, "BackoffSecondsBase": 2 }
    },
    "ExtractionTasks": {
      "MaxAttempts": 3
    },
    "Sidecars": {
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "HealthPath": "/api/version",
        "MaxConcurrency": 1,
        "RequestTimeoutSeconds": 90
      },
      "Docling": {
        "BaseUrl": "http://docling:5001",
        "HealthPath": "/health",
        "ConvertSourcePath": "/v1alpha/convert/source",
        "RequestTimeoutSeconds": 120,
        "MaxConcurrency": 2
      },
      "Parakeet": {
        "BaseUrl": "http://parakeet:5092",
        "HealthPath": "/health",
        "TranscribePath": "/v1/audio/transcriptions",
        "RequestTimeoutSeconds": 180,
        "MaxConcurrency": 1
      },
      "Url": {
        "HeadTimeoutSeconds": 5,
        "GetTimeoutSeconds": 10
      },
      "VideoSplitter": {
        "DownloadTimeoutMinutes": 5
      }
    },
    "Specialists": {
      "Video": { "Enabled": true },
      "VideoSplitter": { "Replicas": 1 }
    },
    "Models": {
      "Vlm":  { "OllamaTag": "openbmb/minicpm-v4.6:q4_K_M", "NumCtx": 4096, "Temperature": 0.2 },
      "Asr":  { "ParakeetVersion": "parakeet-tdt-0.6b-v3-int8" },
      "Docs": { "DoclingVersion": "granite-docling-258m" },
      "Stub": { "Version": "stub-v1" }
    },
    "Filters": {
      "Image": {
        "MinDimension": 100,
        "MaxDimension": 16384,
        "EnableBlurCheck": false,
        "LaplacianVarianceThreshold": 50
      },
      "Document": {
        "MaxSizeBytes": 52428800,
        "MaxPageCount": 200
      },
      "Audio": {
        "MaxSizeBytes": 209715200,
        "MaxDurationSeconds": 600,
        "SilenceRmsThreshold": 0.005,
        "SilenceWindowMs": 100
      },
      "Video": {
        "MaxDurationSeconds": 300,
        "KeyframeIntervalSeconds": 5,
        "MaxKeyframes": 60,
        "JpegQuality": 85
      }
    },
    "Ffmpeg": {
      "Executable": "ffmpeg",
      "FfprobeExecutable": "ffprobe",
      "FfprobeTimeoutSeconds": 15
    }
  }
}
