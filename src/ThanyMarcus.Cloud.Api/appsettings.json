{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "DefaultAnthropicModel": "claude-haiku-4-5-20251001",
    "DefaultOpenAiModel": "gpt-4o-mini",
    "BodySectionHeader": "## Body",
    "AttachmentsSectionHeader": "## Attachments",
    "AttachmentHeaderTemplate": "### Attachment {0} (kind={1})",
    "SystemPrompt": "You enrich short Markdown notes captured by a user. Given the note body and any extracted attachment text, (1) suggest a project folder name if obvious, otherwise null; (2) identify named entities in the body and propose wikilink anchors (text + char offsets + target slug); (3) propose 2-6 short kebab-case tags. Be conservative: prefer few high-quality anchors. Never invent entities not in the input."
  },
  "IngestSaga": {
    "Sidecars": {
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "HealthPath": "/api/version",
        "MaxConcurrency": 1
      },
      "Docling": {
        "BaseUrl": "http://localhost:5001",
        "HealthPath": "/health",
        "MaxConcurrency": 2
      },
      "Parakeet": {
        "BaseUrl": "http://localhost:5092",
        "HealthPath": "/health",
        "MaxConcurrency": 1
      }
    },
    "Models": {
      "Vlm":  { "OllamaTag": "openbmb/minicpm-v4.6:q4_K_M" },
      "Asr":  { "ParakeetVersion": "parakeet-tdt-0.6b-v3-int8" },
      "Docs": { "DoclingVersion": "granite-docling-258m" }
    }
  }
}
