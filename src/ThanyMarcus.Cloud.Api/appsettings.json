{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LlmIntelligence": {
    "Thresholds": {
      "RouteAcceptMin": 0.7,
      "MentionMin": 0.6,
      "SuggestionMatchDistance": 0.11,
      "GrayZoneMergeMaxDistance": 0.18
    },
    "Pgvector": {
      "DedupTopK": 5
    },
    "Retry": {
      "MaxAttempts": 3,
      "BackoffSecondsBase": 2
    },
    "EntitySuggestions": {
      "OccurrenceThreshold": 3,
      "DistinctNoteThreshold": 2,
      "StubsFolder": "_Entities/Stubs"
    },
    "HubMaterializeMin": 3,
    "HubMentionWindow": 20,
    "SurroundingTextChars": 200,
    "RoutingFoldersMax": 50,
    "RerouteMaxBatch": 200,
    "RerouteCooldownSeconds": 30,
    "EmbeddingContextSamples": 3,
    "DisplayNameHysteresisMargin": 2
  },
  "IngestSaga": {
    "Orchestrator": {
      "MaxConcurrentJobs": 3,
      "LeaseSeconds": 60,
      "HeartbeatSeconds": 20,
      "IdlePollMs": 60000
    },
    "Phases": {
      "extracting_attachments": { "MaxAttempts": 1, "BackoffSecondsBase": 2 },
      "composing":              { "MaxAttempts": 2, "BackoffSecondsBase": 2 },
      "routing":                { "MaxAttempts": 3, "BackoffSecondsBase": 2 },
      "extracting_entities":    { "MaxAttempts": 3, "BackoffSecondsBase": 2 },
      "embedding":              { "MaxAttempts": 3, "BackoffSecondsBase": 2 }
    },
    "ExtractionTasks": {
      "MaxAttempts": 3
    },
    "Sidecars": {
      "OllamaVision": {
        "BaseUrl": "http://localhost:11434",
        "HealthPath": "/api/version",
        "MaxConcurrency": 1,
        "RequestTimeoutSeconds": 1200
      },
      "OllamaText": {
        "BaseUrl": "http://localhost:11434",
        "HealthPath": "/api/version",
        "MaxConcurrency": 1,
        "RequestTimeoutSeconds": 900
      },
      "Docling": {
        "BaseUrl": "http://docling:5001",
        "HealthPath": "/health",
        "ConvertSourcePath": "/v1alpha/convert/source",
        "RequestTimeoutSeconds": 120,
        "MaxConcurrency": 2
      },
      "Parakeet": {
        "BaseUrl": "http://parakeet:5092",
        "HealthPath": "/health",
        "TranscribePath": "/v1/audio/transcriptions",
        "RequestTimeoutSeconds": 180,
        "MaxConcurrency": 1
      },
      "Url": {
        "HeadTimeoutSeconds": 5,
        "GetTimeoutSeconds": 10
      },
      "VideoSplitter": {
        "DownloadTimeoutMinutes": 5
      }
    },
    "Specialists": {
      "Video": { "Enabled": true },
      "VideoSplitter": { "Replicas": 1 }
    },
    "Models": {
      "Vlm":    { "OllamaTag": "qwen3-vl:4b", "NumCtx": 4096, "Temperature": 0.2 },
      "Route":  { "OllamaTag": "qwen3:1.7b-q4_K_M",  "NumCtx": 4096, "Temperature": 0.1 },
      "Entity": { "OllamaTag": "qwen3:1.7b-q4_K_M",  "NumCtx": 4096, "Temperature": 0.1 },
      "Asr":  { "ParakeetVersion": "parakeet-tdt-0.6b-v3-int8" },
      "Docs": { "DoclingVersion": "granite-docling-258m" },
      "Stub": { "Version": "stub-v1" },
      "Embedding": {
        "ModelPath": "/app/models/granite/model.onnx",
        "TokenizerPath": "/app/models/granite/tokenizer.json",
        "MaxTokens": 512,
        "EmbeddingDim": 256,
        "FullDim": 768,
        "ModelTag": "ibm-granite/granite-embedding-311m-multilingual-r2",
        "ModelRevision": "main",
        "MaxConcurrency": 2
      }
    },
    "Filters": {
      "Image": {
        "MinDimension": 100,
        "MaxDimension": 16384,
        "EnableBlurCheck": false,
        "LaplacianVarianceThreshold": 50,
        "VlmMaxDimension": 1024,
        "VlmJpegQscale": 5,
        "VlmResizeTimeoutSeconds": 30
      },
      "Document": {
        "MaxSizeBytes": 52428800,
        "MaxPageCount": 200
      },
      "Audio": {
        "MaxSizeBytes": 209715200,
        "MaxDurationSeconds": 600,
        "SilenceRmsThreshold": 0.005,
        "SilenceWindowMs": 100
      },
      "Video": {
        "MaxDurationSeconds": 300,
        "KeyframeIntervalSeconds": 5,
        "MaxKeyframes": 60,
        "JpegQuality": 85
      }
    },
    "Ffmpeg": {
      "Executable": "ffmpeg",
      "FfprobeExecutable": "ffprobe",
      "FfprobeTimeoutSeconds": 15
    },
    "Retrieval": {
      "MaxDistance": 0.15,
      "MaxDistanceFloor": 0.10,
      "MaxDistanceCeiling": 0.28,
      "QueryDocOffset": 0.04,
      "DefaultK": 5,
      "MaxK": 20,
      "MinBodyChars": 30,
      "Fanout": 30,
      "Lambda": 0.6,
      "AutoCalibrationEnabled": true,
      "AutoMinNotes": 40,
      "AutoMinPositivePairs": 30,
      "AutoMinNegativePairs": 30,
      "AutoStaleNoteDelta": 25,
      "AutoStaleEntityDelta": 15,
      "AutoHysteresisMargin": 0.03,
      "AutoMinAuc": 0.6,
      "AutoRandomSampleSize": 2000,
      "AutoCheckCooldownSeconds": 300,
      "QueryCache": {
        "TtlSeconds": 90,
        "MaxEntries": 500
      }
    }
  }
}
